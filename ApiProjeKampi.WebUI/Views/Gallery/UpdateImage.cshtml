@model UpdateImageDto

@{
    ViewData["Title"] = "UpdateImage";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Görsel Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-controller="Gallery" asp-action="UpdateImage">
                            <input type="hidden" asp-for="ImageId" />
                            <label>Görsel Başlığı</label>
                            <input type="text" asp-for="Title" class="form-control" />
                            <br />
                            <label>Görsel Url Adresi</label>
                            <input type="text" asp-for="ImageUrl" class="form-control" />
                            <br />

                            <button class="btn btn-primary">Görsel Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

